ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=freelanceflow;Username=ff;Password=${DB_PASSWORD}
# Public host name Caddy serves and gets the TLS certificate for (docker-compose passes it to the `web` service)
DOMAIN=app.example.com
# Production: absolute https URL of DOMAIN (e.g. https://app.example.com); the API refuses to start otherwise
App__PublicBaseUrl=https://app.example.com
App__MaxUploadMb=20
Seed__DesignerUsername=designer
Seed__DesignerPassword=changeme123!
# Production: real rate limits, fail-fast config guards, Data Protection keys on the `keys` volume.
# Local development runs the API outside Docker (appsettings.Development.json); do not set Development here -
# inside the container it relaxes every limit and keeps the key ring off the volume (everyone signed out per deploy).
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DB_PASSWORD=changeme
# Discord webhook for designer alerts (client requests, storage thresholds). Secret - leave empty to disable.
Notifications__Discord__WebhookUrl=

# Image storage (plan 08): folder inside the api container, backed by the `files` volume in docker-compose.yml
Storage__Local__RootPath=/data/files
# Quota in bytes (10 GB). Uploads stop at 90 %; Discord alerts at 70/85/90/95 %
Storage__QuotaBytes=10737418240

# Data Protection key ring (signs login/portal cookies and public-form tokens), backed by the `keys` volume.
# Must survive restarts, otherwise every deploy signs everyone out. Required outside Development.
DataProtection__KeysPath=/data/keys

# Public new-client form /f/{slug} (plan 13). Defaults shown; tune for production.
# POSTs per IP per hour (sliding window) and reads per IP per minute
RateLimit__PublicIntakeSubmitPerHour=5
RateLimit__PublicIntakePerMinute=10
# Stored submissions per IP per Vietnam day (the studio-wide cap of 30/day is fixed)
PublicIntake__MaxSubmissionsPerIpPerDay=5
