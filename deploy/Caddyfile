{
  admin off
}

:80 {
  redir https://{host}{uri} permanent
}

https://{$DOMAIN} {
  handle /api/* {
    reverse_proxy api:8080
  }
  # Magic-link landing is an SPA route: serve index.html, never send the token on as Referer
  handle /p/* {
    header Referrer-Policy no-referrer
    root * /srv
    rewrite * /index.html
    file_server
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  log {
    output stdout
    format json
  }
}
